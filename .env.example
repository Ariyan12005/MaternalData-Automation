# Copy to .env (git-ignored) and fill in. Never commit real values.
# Start with: python -m dayone --env-file .env
# Setup steps: docs/whatsapp-cloud.md

# simulator (default, no Meta account needed) or cloud
DAYONE_WHATSAPP_MODE=simulator

# Your own random string; paste the same value into App Dashboard > WhatsApp > Configuration > Verify token.
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string

# App Dashboard > App settings > Basic > App secret. Used to check X-Hub-Signature-256.
WHATSAPP_APP_SECRET=replace-with-app-secret

# System user access token (or the temporary token from API Setup, which expires quickly).
WHATSAPP_ACCESS_TOKEN=replace-with-access-token

# Phone number ID shown in App Dashboard > WhatsApp > API Setup (an ID, not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# Graph API version. v26.0 is the latest listed in Meta's Graph API changelog as of 2026-10-03.
WHATSAPP_API_VERSION=v26.0

# Optional settings (defaults shown)
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# WHATSAPP_MEDIA_DIR=var/media/whatsapp
# WHATSAPP_MAX_MEDIA_BYTES=5242880
# WHATSAPP_HTTP_TIMEOUT_SECONDS=10

# Extractor: fixture (default); paddle (local PaddleOCR, primary) or tesseract (optional), both installed as in
# docs/ocr.md and run from the project .venv. http is prepared but refuses to start: Fatma's service has no HTTP
# extraction endpoint (docs/extractor-contract.md). The URL must be https, or http on 127.0.0.1.
# DAYONE_EXTRACTOR=fixture
# DAYONE_OCR_MODELS=medium
# DAYONE_OCR_MODELS_DIR=var/ocr-models
# Local OCR runs one document at a time in one separate process that keeps its models loaded. CPU threads of that
# process (2 to 4), the limit for one page and for all pages of a document, the time allowed to load the models,
# and the folder for temporary page images (outside the repository; default: the system temp folder).
# DAYONE_OCR_CPU_THREADS=4
# DAYONE_OCR_TIMEOUT_SECONDS=120
# DAYONE_OCR_DOCUMENT_TIMEOUT_SECONDS=600
# DAYONE_OCR_START_TIMEOUT_SECONDS=300
# DAYONE_OCR_TMP_DIR=
# DAYONE_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# DAYONE_EXTRACTOR_URL=https://extractor.example/extract
# DAYONE_EXTRACTOR_TIMEOUT_SECONDS=30
