DAYONE_STORAGE=mongodb
DAYONE_MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/?retryWrites=true&w=majority
DAYONE_MONGODB_DATABASE=dayone
DAYONE_ENCRYPTION_KEY=
DAYONE_API_TOKEN=
DAYONE_EXTRACTOR=external
DAYONE_TEST_MONGODB_URI=
# Copy to .env (git-ignored) and fill in. Never commit real values.
# Start with: python -m dayone --env-file .env
# Setup steps: docs/whatsapp-cloud.md

# simulator (default, no Meta account needed) or cloud
DAYONE_WHATSAPP_MODE=simulator

# Your own random string; paste the same value into App Dashboard > WhatsApp > Configuration > Verify token.
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string

# App Dashboard > App settings > Basic > App secret. Used to check X-Hub-Signature-256.
WHATSAPP_APP_SECRET=replace-with-app-secret

# System user access token (or the temporary token from API Setup, which expires quickly).
WHATSAPP_ACCESS_TOKEN=replace-with-access-token

# Phone number ID shown in App Dashboard > WhatsApp > API Setup (an ID, not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# Graph API version. v26.0 is the latest listed in Meta's Graph API changelog as of 2026-10-03.
WHATSAPP_API_VERSION=v26.0

# Optional settings (defaults shown)
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# WHATSAPP_MEDIA_DIR=var/media/whatsapp
# WHATSAPP_MAX_MEDIA_BYTES=5242880
# WHATSAPP_HTTP_TIMEOUT_SECONDS=10
